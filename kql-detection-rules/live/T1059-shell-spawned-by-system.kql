// ============================================================
// T1059 Command and Scripting Interpreter - Shell/script host spawned by SYSTEM
// Sentinel rule: SOC-LAB | Shell/script host spawned by SYSTEM (scheduled, enabled)
// Severity: High | Tactic: Execution
// Source: Security 4688 via Azure Monitor Agent -> Event table
// Note: the DCR routes Windows events to the Event table (not SecurityEvent),
// so fields are parsed from the raw EventData XML with extract().
// Author: Oscar Njumbe | SOC-LAB
// ============================================================

Event
| where EventLog == "Security"
| where EventID == 4688
| extend
    SubjectUserName = extract(@"<Data Name='SubjectUserName'>(.*?)</Data>", 1, EventData),
    NewProcessName  = extract(@"<Data Name='NewProcessName'>(.*?)</Data>", 1, EventData),
    CommandLine     = extract(@"<Data Name='CommandLine'>(.*?)</Data>", 1, EventData),
    ParentProcessName = extract(@"<Data Name='ParentProcessName'>(.*?)</Data>", 1, EventData)
| where SubjectUserName =~ "SYSTEM"
| where NewProcessName has_any ("cmd.exe", "powershell.exe", "wscript.exe", "cscript.exe")
| project TimeGenerated, Computer, NewProcessName, CommandLine, ParentProcessName
